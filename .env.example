# Variables de entorno para Supabase
# Copiar a .env.local (no se sube a git).

# Proyecto Supabase (dashboard → Settings → API / Data API)
# Nomenclatura nueva (dashboard):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY    # antes "anon key"
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=TU_SECRET_KEY                          # antes "service_role key"
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Nomenclatura clásica (alternativa, el código soporta ambas):
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- App ---------------------------------------------------------------------
# URL pública de la app (magic links / invitaciones de staff).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (recordatorios de reservas 24h/2h) -----------------------------------
# Protege /api/cron/* : Authorization: Bearer <CRON_SECRET> o ?secret=<CRON_SECRET>
# OBLIGATORIO en producción (sin él los cron responden 401); en desarrollo opcional.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Opcional: notificaciones WhatsApp (webhook externo) -----------------------
# Usado por src/lib/server/notifications.ts para recordatorios.
WHATSAPP_WEBHOOK_URL=

# --- Opcional: monitoreo de errores --------------------------------------------
# Sentry (el error handling actual loguea en servidor; esto es opt-in).
SENTRY_DSN=

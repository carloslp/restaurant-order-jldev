# Variables de entorno para Supabase
# Copiar a .env.local (no se sube a git).

# Proyecto Supabase (dashboard → Settings → API / Data API)
# Nomenclatura nueva (dashboard):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY    # antes "anon key"
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=TU_SECRET_KEY                          # antes "service_role key"
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Nomenclatura clásica (alternativa, el código soporta ambas):
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY